@section Modals
{
    <!-- Modal Edit Slider -->
    <div class="modal fade" id="EditSlider" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLongTitle">ویرایش اسلایدر</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="col-xl-12 col-lg-12 col-md-12 mb-1">
                        <fieldset class="form-group">

                            <input type="hidden" id="Edit_Id" name="Edit_Id" />

                            <label for="basicInput">تصویر و مسیر تصویر</label>
                            <input type="file" class="form-control" id="Edit_Src" name="Edit_Src">

                            <img id="currentImagePreview" style="width: 120px; height: 120px; margin: 10px auto;" src="" id="Edit_DSrc" alt="پیش نمایش تصویر" />
                            <br/>
                            <label for="basicInput">لینک</label>
                            <input type="text" class="form-control" id="Edit_Link" name="Edit_Link">

                        </fieldset>
                    </div>
                </div>
                <div class="modal-footer">
                    <a class="btn btn-secondary" data-dismiss="modal">بستن</a>
                    <a class="btn btn-primary" onclick="EditSlider()">اعمال تغییرات</a>
                </div>
            </div>
        </div>
    </div>
    <form id="editForm" enctype="multipart/form-data">
    
        <input type="hidden" id="Edit_Id" name="Id" />
        <label for="basicInput">لینک</label>
        <input type="text" class="form-control" id="Edit_Link" name="Link">
    
        <label for="fileInput">تصویر اسلایدر</label>
        <input type="file" class="form-control" id="Edit_Src" name="file">
    
        <img id="currentImagePreview" style="width: 120px; height: 120px;" src="" alt="پیش نمایش تصویر" />
    
        <button type="button" class="btn btn-primary" onclick="EditSlider()">ذخیره تغییرات</button>
    </form>

