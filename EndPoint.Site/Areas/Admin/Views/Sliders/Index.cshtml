        function EditSlider() {
            var fileInput = document.getElementById('Edit_Src');
            var selectedFile = fileInput.files.length > 0 ? fileInput.files[0] : null;
            var imageSrc = $('#Edit_DSrc').attr('src');

            // ایجاد یک شیء FormData
            var formData = new FormData();
            formData.append('Id',$('#Edit_Id').val());
            formData.append('Link',$('#Edit_Link').val());
            // adding file to src for C#
            if (selectedFile) {
                formData.append('Src',selectedFile);
            }
            formData.append('DefaultSrc', imageSrc);

            $.ajax({
                url: '/admin/Sliders/Edit',  // URL سمت سرور که اطلاعات به آن ارسال می‌شود
                type: 'POST',
                data: formData,
                contentType: false,  // بسیار مهم: برای ارسال فایل، contentType باید false باشد
                processData: false,  // بسیار مهم: نباید داده‌ها را پردازش کند
                success: function (response) {
                    if (response.isSuccess) {
                        swal.fire('موفق!', 'اسلایدر با موفقیت ویرایش شد', 'success')
                            .then(() => location.reload());
                    } else {
                        swal.fire('خطا!', 'مشکلی رخ داد', 'error');
                    }
                },
                error: function (request, status, error) {
                    console.log('Error:', request.responseText);
                }
            });
        }


        function ShowModalEditSlider(Id, Src ,Link) {

            var baseUrl = window.location.origin;
//            Src = Src.replace("\\",'-');
//            if (Src.startsWith('/'))
//                Src = '/' + Src;

            var fullPath = baseUrl+ Src;

            $('#Edit_Link').val(Link);
            $('#currentImagePreview').attr('src', fullPath);
            $('#Edit_Id').val(Id);

            $('#EditSlider').modal('show');
        }

    </script>
